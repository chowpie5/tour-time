{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--headless"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "google-maps": {
      "command": "npx",
      "args": ["-y", "@cablate/mcp-google-map@0.0.63", "--stdio"],
      "env": {
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      }
    },
    "weather": {
      "command": "npx",
      "args": ["-y", "open-meteo-mcp-server@2.4.2"]
    }
  }
}
