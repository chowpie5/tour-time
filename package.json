{
  "name": "tour-time",
  "productName": "Tour Time",
  "version": "0.1.0",
  "description": "Desktop app for music tour managers: scheduling, advancing, contacts, budget, documents and tour chat.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "chat-server": "node server/start.cjs",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.tourtime.app",
    "productName": "Tour Time",
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "nanoid": "^5.1.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  }
}
